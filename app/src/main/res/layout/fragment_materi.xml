<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F7FF"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:text="Materi Praktikum"
        android:textColor="#25232A"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:text="Berikut beberapa materi yang sudah dipelajari dalam kelas praktikum."
        android:textColor="#4B4754"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMateri1"
                style="@style/CustomRoundedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Layout dan View Binding" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMateri2"
                style="@style/CustomRoundedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="2. Intent dan Activity" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMateri3"
                style="@style/CustomRoundedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="3. Spinner, Date dan Time Picker" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMateri4"
                style="@style/CustomRoundedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="4. Dialog pada Android" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMateri5"
                style="@style/CustomRoundedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="5. Options Menu dan TabLayout" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>